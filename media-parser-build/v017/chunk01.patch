+    private static JSONArray normalizeMedia(JSONArray input) {
+        JSONArray images = new JSONArray();
+        JSONArray live = new JSONArray();
+        JSONObject mainVideo = null;
+        Set<String> seen = new LinkedHashSet<>();
+        for (int i = 0; i < input.length(); i++) {
+            JSONObject m = input.optJSONObject(i);
+            if (m == null) continue;
+            String url = m.optString("url", "").trim();
+            if (url.isEmpty() || !seen.add(url)) continue;
+            String type = m.optString("type", "image");
+            String label = m.optString("label", "");
+            if ("video".equals(type)) {
+                if (!isPlausibleVideoUrl(url)) continue;
+                boolean isLive = label.toLowerCase().contains("live") || label.contains("实况");
+                if (isLive) live.put(m);
+                else if (mainVideo == null) mainVideo = m;
+            } else if ("image".equals(type)) {
+                images.put(m);
+            }
+        }
+        JSONArray out = new JSONArray();
+        // A normal XHS video note often exposes its cover through imageList. Once a real
+        // main video is found, the cover is metadata rather than a downloadable image item.
+        if (mainVideo != null) {
+            out.put(mainVideo);
+            return out;
+        }
+        for (int i = 0; i < images.length(); i++) out.put(images.optJSONObject(i));
+        for (int i = 0; i < live.length(); i++) out.put(live.optJSONObject(i));
+        return out;
+    }
+
+    private static boolean isPlausibleVideoUrl(String raw) {
+        if (raw == null || raw.isBlank()) return false;
+        try {
+            Uri u = Uri.parse(raw.replaceFirst("^http:", "https:"));
+            String host = u.getHost() == null ? "" : u.getHost().toLowerCase();
+            String path = u.getPath() == null ? "" : u.getPath().toLowerCase();
+            String[] bad = {".js", ".css", ".json", ".html", ".htm", ".svg", ".woff", ".woff2", ".ttf", ".map"};
+            for (String ext : bad) if (path.endsWith(ext)) return false;
+            if (host.contains("sns-video")) return true;
+            return path.endsWith(".mp4") || path.endsWith(".m4v") || path.endsWith(".mov");
+        } catch (Exception e) {
+            return false;
+        }
+    }
