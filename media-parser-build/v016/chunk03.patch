+package com.example.mediaparser.subtitle;
+
+import java.util.Collections;
+import java.util.List;
+
+public final class SubtitleOutput {
+    public final List<SubtitleSegment> segments;
+    public final String fullText;
+    public final String srt;
+    public final String detectedLanguage;
+    public final String srtLocation;
+    public final String txtLocation;
+
+    public SubtitleOutput(List<SubtitleSegment> segments, String fullText, String srt,
+                          String detectedLanguage, String srtLocation, String txtLocation) {
+        this.segments = Collections.unmodifiableList(segments);
+        this.fullText = fullText == null ? "" : fullText;
+        this.srt = srt == null ? "" : srt;
+        this.detectedLanguage = detectedLanguage == null ? "" : detectedLanguage;
+        this.srtLocation = srtLocation == null ? "" : srtLocation;
+        this.txtLocation = txtLocation == null ? "" : txtLocation;
+    }
+}
