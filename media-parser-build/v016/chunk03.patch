+            while (nextSourcePos <= sourceIndex + 1e-9) {
+                double frac = nextSourcePos - left;
+                if (frac >= -1e-9 && frac <= 1.0000001) {
+                    output.add(clamp((float) (prev + (current - prev) * frac)));
+                }
+                nextSourcePos += step;
+            }
+            prev = current;
+        }
+
+        private static float clamp(float v) {
+            return Math.max(-1f, Math.min(1f, v));
+        }
+    }
+
+    private static final class FloatBuilder {
+        float[] data = new float[16000 * 30];
+        int size;
+
+        void add(float v) {
+            if (size == data.length) {
+                int next = Math.min(MAX_TARGET_SAMPLES, Math.max(data.length + 1, data.length + data.length / 2));
+                if (next <= data.length) throw new IllegalStateException("音频过长");
+                data = Arrays.copyOf(data, next);
+            }
+            data[size++] = v;
+        }
+
+        float[] toArray() { return Arrays.copyOf(data, size); }
+    }
+}
