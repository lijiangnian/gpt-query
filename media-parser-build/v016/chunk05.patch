+                if (loc == null || loc.isBlank()) throw new IllegalStateException("模型下载重定向失败");
+                current = URI.create(current).resolve(loc).toString();
+                continue;
+            }
+            if (status < 200 || status >= 300) {
+                c.disconnect();
+                throw new IllegalStateException("字幕模型下载失败 HTTP " + status);
+            }
+            long total = c.getContentLengthLong();
+            if (total <= 0) total = MODEL_SIZE_BYTES;
+            long downloaded = 0L;
+            try (InputStream in = c.getInputStream(); FileOutputStream out = new FileOutputStream(outFile)) {
+                byte[] buf = new byte[256 * 1024];
+                int n;
+                long nextNotify = 0L;
+                while ((n = in.read(buf)) != -1) {
+                    out.write(buf, 0, n);
+                    downloaded += n;
+                    if (listener != null && downloaded >= nextNotify) {
+                        listener.onModelProgress(downloaded, total);
+                        nextNotify = downloaded + 1024L * 1024L;
+                    }
+                }
+                out.getFD().sync();
+            } finally {
+                c.disconnect();
+            }
+            if (listener != null) listener.onModelProgress(downloaded, total);
+            return;
+        }
+        throw new IllegalStateException("字幕模型下载重定向过多");
+    }
+
+    private static String sha256(File f) throws Exception {
+        MessageDigest md = MessageDigest.getInstance("SHA-256");
+        try (FileInputStream in = new FileInputStream(f)) {
+            byte[] buf = new byte[1024 * 1024];
+            int n;
+            while ((n = in.read(buf)) != -1) md.update(buf, 0, n);
+        }
+        StringBuilder sb = new StringBuilder(64);
+        for (byte b : md.digest()) sb.append(String.format(Locale.ROOT, "%02x", b & 0xff));
+        return sb.toString();
+    }
+
+    private static void copy(File from, File to) throws Exception {
+        try (FileInputStream in = new FileInputStream(from); FileOutputStream out = new FileOutputStream(to)) {
+            byte[] buf = new byte[1024 * 1024];
+            int n;
+            while ((n = in.read(buf)) != -1) out.write(buf, 0, n);
+            out.getFD().sync();
+        }
+    }
+
+    private static void writeMarker(File marker) throws Exception {
+        try (FileOutputStream out = new FileOutputStream(marker)) {
+            out.write(MODEL_SHA256.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+            out.getFD().sync();
+        }
+    }
+}
