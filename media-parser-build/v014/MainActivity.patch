+    private void openAudioFolder() {
+        Uri folderUri = DocumentsContract.buildDocumentUri(
+                "com.android.externalstorage.documents",
+                "primary:Music/MediaParser"
+        );
+        try {
+            Intent view = new Intent(Intent.ACTION_VIEW);
+            view.setDataAndType(folderUri, DocumentsContract.Document.MIME_TYPE_DIR);
+            view.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
+            startActivity(view);
+            return;
+        } catch (Exception ignored) {
+        }
+
+        try {
+            Intent tree = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
+                tree.putExtra("android.provider.extra.INITIAL_URI", folderUri);
+            }
+            startActivity(tree);
+            toast("音频目录：Music/MediaParser");
+        } catch (Exception e) {
+            toast("请在文件管理中打开：Music/MediaParser");
+        }
+    }
